{
  "manifest_version": 3,
  "name": "Zenbot",
  "version": "0.3.1",
  "description": "Turn a short note into a complete Zendesk reply.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://api.openai.com/*", "https://*.zendesk.com/*"],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["https://*.zendesk.com/agent/*"],
    "css": ["panel.css"],
    "js": ["settings-info.js", "content.js"]
  }],
  "web_accessible_resources": [{
    "resources": ["panel.html"],
    "matches": ["https://*.zendesk.com/*"]
  }],
  "action": {
    "default_popup": "popup.html"
  }
}
